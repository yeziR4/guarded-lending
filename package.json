{
  "name": "sh",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/nextjs",
      "packages/foundry"
    ]
  },
  "scripts": {
    "foundry:account": "npm run account -w @sh/foundry --",
    "foundry:account:generate": "npm run account:generate -w @sh/foundry --",
    "foundry:account:import": "npm run account:import -w @sh/foundry --",
    "foundry:account:reveal-pk": "npm run account:reveal-pk -w @sh/foundry --",
    "foundry:chain": "npm run chain -w @sh/foundry --",
    "foundry:clean": "npm run clean -w @sh/foundry --",
    "foundry:compile": "npm run compile -w @sh/foundry --",
    "foundry:test": "npm run test -w @sh/foundry --",
    "foundry:test:local": "npm run test:local -w @sh/foundry --",
    "foundry:test:testnet": "npm run test:testnet -w @sh/foundry --",
    "foundry:test:mainnet": "npm run test:mainnet -w @sh/foundry --",
    "foundry:deploy": "npm run deploy -w @sh/foundry --",
    "foundry:setup": "npm run setup -w @sh/foundry --",
    "foundry:flatten": "npm run flatten -w @sh/foundry --",
    "foundry:fork": "npm run fork -w @sh/foundry --",
    "foundry:format": "npm run format -w @sh/foundry --",
    "foundry:lint": "npm run lint -w @sh/foundry --",
    "foundry:lint-staged": "npm run lint-staged -w @sh/foundry --",
    "foundry:verify:testnet": "npm run verify:testnet -w @sh/foundry --",
    "foundry:verify:mainnet": "npm run verify:mainnet -w @sh/foundry --",
    "format": "npm run next:format -- && npm run foundry:format --",
    "lint": "npm run next:lint -- && npm run foundry:lint --",
    "next:build": "npm run build -w @sh/nextjs --",
    "next:check-types": "npm run check-types -w @sh/nextjs --",
    "next:dev": "npm run dev -w @sh/nextjs --",
    "next:format": "npm run format -w @sh/nextjs --",
    "next:lint": "npm run lint -w @sh/nextjs --",
    "next:serve": "npm run serve -w @sh/nextjs --",
    "next:start": "npm run start -w @sh/nextjs --"
  },
  "packageManager": "npm@10.0.0",
  "devDependencies": {
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10"
  },
  "engines": {
    "node": ">=20.18.3"
  }
}
