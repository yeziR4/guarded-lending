NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# Optional. Pyth Hermes API key (server-side only, never NEXT_PUBLIC_). Without it the Pyth source stays
# stale and the OracleGuard runs on Chainlink + Supra. Get one at https://www.pyth.network/
PYTH_API_KEY=
# PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes

# HCS topic the audit relayer publishes to (printed by `npm run foundry:relay` on first run).
NEXT_PUBLIC_AUDIT_TOPIC_ID=
